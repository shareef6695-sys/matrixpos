// MatrixPOS database schema.
// All money is stored as integer pence. All weights are stored as integer grams.
// Every business (tenant) is an Organization; branches are Stores; tills are Registers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct (session) connection. With Supabase, DATABASE_URL goes
  // through the transaction pooler (port 6543) and DIRECT_URL through session mode (5432).
  // With plain Postgres, set DIRECT_URL to the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum Role {
  OWNER
  MANAGER
  SUPERVISOR
  CASHIER
}

enum VatCode {
  STANDARD // 20%
  REDUCED // 5%
  ZERO // 0%
  EXEMPT // outside VAT
}

enum PricingUnit {
  EACH
  PER_KG
}

enum PromotionType {
  MULTIBUY_PRICE // buy N for £X (e.g. 3 for £2)
  BUY_X_GET_Y // buy X get Y free (BOGOF = 1/1)
  PERCENT_OFF // n% off
  MEAL_DEAL // one item from each group for a fixed price
}

enum PaymentMethod {
  CASH
  CARD_MANUAL // card taken on a standalone terminal, keyed by cashier
  STRIPE_TERMINAL
  SUMUP
  DOJO
  VOUCHER
}

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum SaleKind {
  SALE
  REFUND
}

enum StockMovementType {
  SALE
  REFUND
  RECEIVED
  ADJUSTMENT
  WASTE
  TRANSFER_IN
  TRANSFER_OUT
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  vatNumber     String? // e.g. GB123456789
  companyNo     String?
  receiptFooter String?
  brandColor    String   @default("#0f766e")
  currency      String   @default("GBP")
  createdAt     DateTime @default(now())

  // Subscription, managed by the platform owner at /platform.
  plan                 Plan          @default(BUSINESS)
  billingStatus        BillingStatus @default(TRIAL)
  billingCycle         BillingCycle  @default(MONTHLY)
  trialEndsAt          DateTime?
  paidUntil            DateTime?
  billingNote          String?
  // Card payments through Stripe Billing (optional; invoicing still works without it).
  stripeCustomerId     String?       @unique
  stripeSubscriptionId String?       @unique

  // Legal: when the owner accepted the terms, privacy policy and data processing agreement.
  termsAcceptedAt    DateTime?
  termsVersion       String?
  // Owner asked to close the account. Data is deleted 30 days later.
  closureRequestedAt DateTime?

  // Feature activation: each business switches on what it needs.
  settings OrgSettings?

  stores               Store[]
  users                User[]
  categories           Category[]
  products             Product[]
  promotions           Promotion[]
  suppliers            Supplier[]
  customers            Customer[]
  auditLogs            AuditLog[]
  ledgerAccounts       LedgerAccount[]
  journals             JournalEntry[]
  bills                Bill[]
  subscriptionInvoices SubscriptionInvoice[]
  pricingSnapshots     PricingSnapshot[]
  cardPayments         CardPayment[]
}

model OrgSettings {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique

  // Payment methods the business has activated
  enableCash           Boolean @default(true)
  enableCardManual     Boolean @default(true)
  enableStripeTerminal Boolean @default(false)
  enableSumUp          Boolean @default(false)
  enableDojo           Boolean @default(false)

  // Provider credentials (server-side only, never sent to the browser)
  stripeSecretKey   String?
  sumupApiKey       String?
  sumupMerchantCode String?
  dojoApiKey        String?

  // Modules
  enablePromotions   Boolean @default(true)
  enableAgeCheck     Boolean @default(true)
  enableWeighedItems Boolean @default(true)
  enableStockControl Boolean @default(true)
  enableLoyalty      Boolean @default(false)
  enableOfflineMode  Boolean @default(true)
  enableAccounting   Boolean @default(true)

  // UK variable-measure barcodes (EAN-13 starting with 2): price-embedded or weight-embedded
  embeddedBarcodeMode String @default("PRICE") // PRICE | WEIGHT | OFF

  ageCheckThreshold       Int     @default(25) // Challenge 25
  loyaltyPointsPerPound   Int     @default(1)
  requireManagerForRefund Boolean @default(true)
  requireManagerForVoid   Boolean @default(true)
}

model Store {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  code           String // short code printed on receipts, e.g. "LDN1"
  addressLine1   String?
  addressLine2   String?
  town           String?
  postcode       String?
  phone          String?
  createdAt      DateTime     @default(now())

  registers      Register[]
  stockLevels    StockLevel[]
  sales          Sale[]
  shifts         Shift[]
  movements      StockMovement[]
  purchaseOrders PurchaseOrder[]
  users          UserStore[]

  @@unique([organizationId, code])
}

model Register {
  id             String   @id @default(cuid())
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId        String
  name           String // "Till 1"
  number         Int
  stripeReaderId String?
  sumupReaderId  String?
  dojoTerminalId String?
  createdAt      DateTime @default(now())

  sales  Sale[]
  shifts Shift[]

  @@unique([storeId, number])
}

model User {
  id              String       @id @default(cuid())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String
  name            String
  email           String?      @unique
  passwordHash    String? // back office login (owners and managers)
  pinHash         String // till login
  role            Role         @default(CASHIER)
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  emailVerifiedAt DateTime?
  sessionVersion  Int          @default(0) // bumped to sign the person out everywhere
  totpSecret      String? // two-step sign-in (authenticator app), base32
  totpEnabledAt   DateTime?
  authTokens      AuthToken[]
  hqMember        HqMember?

  stores    UserStore[]
  sales     Sale[]
  shifts    Shift[]
  auditLogs AuditLog[]
}

model UserStore {
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId String

  @@id([userId, storeId])
}

model Category {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  color          String       @default("#64748b")
  sortOrder      Int          @default(0)
  products       Product[]

  @@unique([organizationId, name])
}

model Product {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  category       Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId     String?
  supplier       Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierId     String?

  name         String
  sku          String?
  plu          String? // short code for loose items and embedded barcodes
  pricePence   Int // VAT inclusive; per kg when unit = PER_KG
  costPence    Int? // VAT exclusive cost price
  vatCode      VatCode     @default(STANDARD)
  unit         PricingUnit @default(EACH)
  minAge       Int? // 16 or 18 for age-restricted goods
  trackStock   Boolean     @default(true)
  reorderLevel Int?
  reorderQty   Int?
  quickKey     Boolean     @default(false) // show as a button on the till
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  barcodes       Barcode[]
  stockLevels    StockLevel[]
  saleLines      SaleLine[]
  movements      StockMovement[]
  promotionItems PromotionItem[]
  poLines        PurchaseOrderLine[]

  @@unique([organizationId, sku])
  @@unique([organizationId, plu])
  @@index([organizationId, name])
}

model Barcode {
  id             String  @id @default(cuid())
  organizationId String
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId      String
  code           String
  packQty        Int     @default(1) // outer case barcodes can sell multiple units

  @@unique([organizationId, code])
}

model StockLevel {
  store     Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId   String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  quantity  Int     @default(0) // units, or grams for PER_KG products

  @@id([storeId, productId])
}

model StockMovement {
  id        String            @id @default(cuid())
  store     Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId   String
  product   Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  type      StockMovementType
  quantity  Int // signed
  reference String?
  note      String?
  userId    String?
  createdAt DateTime          @default(now())

  @@index([storeId, productId, createdAt])
}

model Promotion {
  id             String        @id @default(cuid())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String // shown on receipt, e.g. "3 for £2"
  type           PromotionType
  // MULTIBUY_PRICE: quantity + pricePence. BUY_X_GET_Y: quantity (buy) + freeQuantity.
  // PERCENT_OFF: percentOff. MEAL_DEAL: pricePence, items carry a group number.
  quantity       Int?
  freeQuantity   Int?
  pricePence     Int?
  percentOff     Int?
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())

  items PromotionItem[]
}

model PromotionItem {
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  promotionId String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  group       Int       @default(1) // meal deal group: 1 main, 2 snack, 3 drink

  @@id([promotionId, productId])
}

model Customer {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  email          String?
  phone          String?
  loyaltyCode    String?
  points         Int          @default(0)
  marketingOptIn Boolean      @default(false) // UK GDPR / PECR consent
  createdAt      DateTime     @default(now())
  sales          Sale[]

  @@unique([organizationId, loyaltyCode])
}

model Shift {
  id                String         @id @default(cuid())
  store             Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId           String
  register          Register       @relation(fields: [registerId], references: [id], onDelete: Cascade)
  registerId        String
  user              User           @relation(fields: [userId], references: [id])
  userId            String
  openedAt          DateTime       @default(now())
  closedAt          DateTime?
  openingFloatPence Int            @default(0)
  countedCashPence  Int?
  expectedCashPence Int?
  zNumber           Int? // sequential Z report number per register
  sales             Sale[]
  cashMovements     CashMovement[]
}

model CashMovement {
  id          String   @id @default(cuid())
  shift       Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  shiftId     String
  amountPence Int // positive = paid in, negative = paid out / safe drop
  reason      String
  userId      String
  createdAt   DateTime @default(now())
}

model Sale {
  id             String     @id // client-generated UUID so offline sales sync idempotently
  organizationId String
  store          Store      @relation(fields: [storeId], references: [id])
  storeId        String
  register       Register   @relation(fields: [registerId], references: [id])
  registerId     String
  shift          Shift?     @relation(fields: [shiftId], references: [id])
  shiftId        String?
  user           User       @relation(fields: [userId], references: [id])
  userId         String
  customer       Customer?  @relation(fields: [customerId], references: [id])
  customerId     String?
  receiptNo      String // e.g. LDN1-1-000123
  kind           SaleKind   @default(SALE)
  status         SaleStatus @default(COMPLETED)
  originalSaleId String? // for refunds
  subtotalPence  Int // before promotions
  discountPence  Int
  totalPence     Int // VAT inclusive, signed (negative for refunds)
  vatPence       Int
  changePence    Int        @default(0)
  ageVerified    Boolean    @default(false)
  createdAt      DateTime // till time
  syncedAt       DateTime   @default(now())

  lines    SaleLine[]
  payments Payment[]
  vatLines SaleVat[]

  @@unique([organizationId, receiptNo])
  @@index([organizationId, storeId, createdAt])
}

model SaleLine {
  id             String      @id @default(cuid())
  sale           Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId         String
  product        Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId      String?
  name           String
  quantity       Int // units, or grams for weighed lines
  unit           PricingUnit
  unitPricePence Int
  grossPence     Int // before discount
  discountPence  Int
  netPence       Int // after discount, VAT inclusive
  vatCode        VatCode
  vatRate        Int // basis points, 2000 = 20%
  promotionName  String?
}

model SaleVat {
  sale       Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId     String
  vatCode    VatCode
  vatRate    Int
  grossPence Int
  vatPence   Int

  @@id([saleId, vatCode])
}

model Payment {
  id          String        @id @default(cuid())
  sale        Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  saleId      String
  method      PaymentMethod
  amountPence Int // signed
  reference   String? // provider transaction id or last 4 digits
  createdAt   DateTime      @default(now())
}

model Supplier {
  id             String          @id @default(cuid())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  contactName    String?
  email          String?
  phone          String?
  accountNo      String?
  products       Product[]
  purchaseOrders PurchaseOrder[]
  bills          Bill[]

  @@unique([organizationId, name])
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  organizationId String
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  supplierId     String
  store          Store               @relation(fields: [storeId], references: [id])
  storeId        String
  reference      String
  status         PurchaseOrderStatus @default(DRAFT)
  notes          String?
  createdAt      DateTime            @default(now())
  receivedAt     DateTime?
  lines          PurchaseOrderLine[]
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseOrderId String
  product         Product       @relation(fields: [productId], references: [id])
  productId       String
  quantity        Int
  receivedQty     Int           @default(0)
  costPence       Int?
}

model Counter {
  // Sequential numbers (receipts, Z reports, PO refs) per scope
  key   String @id
  value Int    @default(0)
}

model AuditLog {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId         String?
  action         String
  detail         Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

// ---------------- Accounting (double entry) ----------------

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum JournalSource {
  SALE
  SALE_VOID
  BILL
  BILL_PAYMENT
  STOCK
  CASH
  SHIFT
  TRANSFER
  MANUAL
}

model LedgerAccount {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  code           String
  name           String
  type           AccountType
  systemKey      String? // e.g. SALES, VAT_OUTPUT: used by automatic postings
  isBank         Boolean      @default(false) // bank or cash account money can be paid from
  archived       Boolean      @default(false)

  lines JournalLine[]

  @@unique([organizationId, code])
  @@unique([organizationId, systemKey])
}

model JournalEntry {
  id             String        @id @default(cuid())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  date           DateTime
  reference      String?
  memo           String?
  source         JournalSource
  sourceId       String? // the sale, bill, movement etc. that created it
  userId         String?
  createdAt      DateTime      @default(now())

  lines JournalLine[]

  @@unique([organizationId, source, sourceId])
  @@index([organizationId, date])
}

model JournalLine {
  id          String        @id @default(cuid())
  entry       JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  entryId     String
  account     LedgerAccount @relation(fields: [accountId], references: [id])
  accountId   String
  debitPence  Int           @default(0)
  creditPence Int           @default(0)
  description String?

  @@index([accountId])
}

model Bill {
  id              String       @id @default(cuid())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String
  supplier        Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierId      String?
  payee           String // supplier or shop name as on the invoice/receipt
  date            DateTime
  dueDate         DateTime?
  reference       String? // invoice number
  accountId       String // what it was for (stock purchases, rent, electricity...)
  vatCode         VatCode
  netPence        Int
  vatPence        Int
  grossPence      Int
  paidAt          DateTime?
  paidFromId      String? // bank or cash account
  purchaseOrderId String?
  notes           String?
  createdAt       DateTime     @default(now())

  @@index([organizationId, date])
}

enum Plan {
  STARTER
  BUSINESS
  ENTERPRISE
}

enum BillingStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum AuthTokenKind {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/**
 * One-time links sent by email. Only a hash of the token is stored.
 */
model AuthToken {
  id        String        @id @default(cuid())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  kind      AuthTokenKind
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, kind])
}

/**
 * Back office sign-in attempts, for rate limiting. Old rows are purged daily.
 */
model LoginAttempt {
  id        String   @id @default(cuid())
  key       String // "email:<address>" or "ip:<address>"
  success   Boolean
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

enum InvoiceStatus {
  OPEN
  PAID
  VOID
}

/**
 * MatrixPOS's invoices to a business for its subscription (card via Stripe, or bank transfer).
 * These are MatrixPOS's own tax records, so they outlive the business's account: when a closed business is
 * deleted, organizationId becomes null and the bill-to email is cleared. They're deleted 7 years after issue.
 */
model SubscriptionInvoice {
  id              String        @id @default(cuid())
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  organizationId  String?
  number          String        @unique // MPI-0001, or Stripe's own number for card invoices
  status          InvoiceStatus @default(OPEN)
  method          String        @default("BANK") // BANK or CARD
  description     String
  periodStart     DateTime?
  periodEnd       DateTime?
  netPence        Int
  vatPence        Int
  totalPence      Int
  issuedAt        DateTime      @default(now())
  dueAt           DateTime?
  paidAt          DateTime?
  // Snapshot of who it was billed to
  billToName      String
  billToEmail     String?
  billToAddress   String?
  billToVatNumber String?
  stripeInvoiceId String?       @unique
  stripePdfUrl    String?
  emailedAt       DateTime?
  createdAt       DateTime      @default(now())

  @@index([organizationId, issuedAt])
}

/**
 * Sessions and one-time codes that must not be accepted again before they expire: back office and till
 * sessions after sign-out, and authenticator codes once used. Rows are purged daily once expired.
 */
model RevokedToken {
  id        String   @id // "jti:<session id>" or "totp:<user id>:<time step>"
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/**
 * The prices, VAT codes and offers a till was given (in /api/till/bootstrap), so the server can re-price every
 * sale itself with exactly what the till had, even if it was offline while prices changed. Kept for 30 days.
 */
model PricingSnapshot {
  id             String       @id // sha256 of the business id and the data
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  data           Json
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
}

/**
 * A payment on an integrated card machine (Stripe Terminal, SumUp, Dojo), recorded by the server when the till
 * starts it and marked approved only when the provider says so. A sale can only claim a card machine payment
 * that is here, approved, for the same sale and amount, and not already used.
 */
model CardPayment {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  registerId     String
  saleId         String
  provider       String // STRIPE_TERMINAL | SUMUP | DOJO
  ref            String // the provider's id for this payment attempt
  amountPence    Int
  approvedAt     DateTime?
  reference      String? // provider's transaction id once approved
  usedAt         DateTime? // set when a sale using this payment is saved
  createdAt      DateTime     @default(now())

  @@unique([provider, ref])
  @@index([organizationId, saleId])
}

// ---------------- Matrix HQ: running Matrix Infotech Ltd. ----------------
// These tables belong to the platform owner's own business (custom software, resold apps, POS plans),
// not to any shop. Only HQ (platform admins and HQ staff) can reach them. Money is in integer minor
// units of the document's currency (pence, cents, fils...), and every document keeps the exchange rate
// to GBP it was issued at, so the GBP figures never change afterwards.

enum HqRole {
  MANAGER // every business module, but not HQ staff or shop customers
  SALES // clients, leads, quotes
  ACCOUNTS // clients, invoices, payments, catalogue, exchange rates
  PROJECTS // reads clients and the catalogue (projects arrive in phase 3)
  VIEWER // reads everything, changes nothing
}

/**
 * A member of HQ staff. They sign in like any back office user, but can only use HQ, never a shop.
 */
model HqMember {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String   @unique
  role        HqRole   @default(VIEWER)
  invitedById String?
  createdAt   DateTime @default(now())
}

enum HqItemKind {
  SERVICE // custom build, consulting, design, hourly work
  SUBSCRIPTION // recurring plans, hosting, support
  PRODUCT // licences, hardware, one-off products
  THIRD_PARTY // apps and services resold from another vendor
}

/**
 * Everything Matrix Infotech sells.
 */
model HqItem {
  id              String     @id @default(cuid())
  name            String
  sku             String?    @unique
  kind            HqItemKind @default(SERVICE)
  description     String?
  unit            String     @default("each") // each, hour, day, month, year
  currency        String     @default("GBP")
  priceMinor      Int        @default(0)
  costMinor       Int? // what it costs you (for third-party items)
  vendor          String? // who supplies a third-party item
  url             String? // the page on your website
  incomeAccount   HqAccount? @relation(fields: [incomeAccountId], references: [id], onDelete: SetNull)
  incomeAccountId String? // where sales of it go in the books (blank = by type)
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  lines HqLine[]
}

model HqClient {
  id           String   @id @default(cuid())
  name         String
  isCompany    Boolean  @default(true)
  email        String?
  phone        String?
  website      String?
  addressLine1 String?
  addressLine2 String?
  town         String?
  postcode     String?
  country      String   @default("United Kingdom")
  vatNumber    String?
  companyNo    String?
  currency     String   @default("GBP")
  paymentDays  Int      @default(14)
  notes        String?
  ownerId      String? // the HQ user looking after this client
  archived     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contacts  HqContact[]
  leads     HqLead[]
  quotes    HqQuote[]
  invoices  HqInvoice[]
  notesLog  HqNote[]
  recurring HqRecurring[]
  projects  HqProject[]
  contracts HqContract[]

  @@index([name])
}

model HqContact {
  id        String   @id @default(cuid())
  client    HqClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  name      String
  email     String?
  phone     String?
  jobTitle  String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([clientId])
}

enum HqLeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

model HqLead {
  id            String      @id @default(cuid())
  title         String // what they want, e.g. "Booking app for a dental clinic"
  company       String?
  contactName   String?
  email         String?
  phone         String?
  source        String? // website, WhatsApp, referral...
  stage         HqLeadStage @default(NEW)
  currency      String      @default("GBP")
  valueMinor    Int         @default(0)
  expectedClose DateTime?
  ownerId       String?
  client        HqClient?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId      String?
  lostReason    String?
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  notesLog HqNote[]

  @@index([stage])
}

/**
 * A note, call or meeting on a client or lead's timeline.
 */
model HqNote {
  id        String    @id @default(cuid())
  client    HqClient? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String?
  lead      HqLead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId    String?
  kind      String    @default("NOTE") // NOTE, CALL, EMAIL, MEETING
  body      String
  userId    String?
  userName  String?
  createdAt DateTime  @default(now())

  @@index([clientId, createdAt])
  @@index([leadId, createdAt])
}

/**
 * How many units of a currency one pound buys, as of a date. Typed in by HQ (no outside feed).
 */
model HqFxRate {
  id        String   @id @default(cuid())
  currency  String
  perGbp    Decimal  @db.Decimal(18, 8)
  date      DateTime
  createdAt DateTime @default(now())

  @@unique([currency, date])
}

enum HqQuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  INVOICED
}

model HqQuote {
  id            String        @id @default(cuid())
  number        String        @unique // MPQ-2026-K7Q3M
  client        HqClient      @relation(fields: [clientId], references: [id])
  clientId      String
  title         String?
  status        HqQuoteStatus @default(DRAFT)
  issueDate     DateTime
  expiryDate    DateTime?
  currency      String        @default("GBP")
  perGbp        Decimal       @default(1) @db.Decimal(18, 8)
  subtotalMinor Int           @default(0)
  discountMinor Int           @default(0)
  taxMinor      Int           @default(0)
  totalMinor    Int           @default(0)
  notes         String?
  terms         String?
  publicToken   String        @unique // for the client's view-and-accept link
  sentAt        DateTime?
  respondedAt   DateTime?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  lines   HqLine[]
  invoice HqInvoice?

  @@index([status])
}

enum HqInvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  VOID
}

model HqInvoice {
  id              String          @id @default(cuid())
  number          String          @unique // MPI-2026-K7Q3M, shared with the POS subscription invoices
  client          HqClient        @relation(fields: [clientId], references: [id])
  clientId        String
  quote           HqQuote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  quoteId         String?         @unique
  title           String?
  status          HqInvoiceStatus @default(DRAFT)
  issueDate       DateTime
  dueDate         DateTime
  currency        String          @default("GBP")
  perGbp          Decimal         @default(1) @db.Decimal(18, 8)
  subtotalMinor   Int             @default(0)
  discountMinor   Int             @default(0)
  taxMinor        Int             @default(0)
  totalMinor      Int             @default(0)
  paidMinor       Int             @default(0)
  notes           String?
  terms           String?
  // Who it was billed to, as it was on the day it was sent.
  billToName      String?
  billToAddress   String?
  billToEmail     String?
  billToVatNumber String?
  publicToken     String          @unique
  sentAt          DateTime?
  paidAt          DateTime?
  voidedAt        DateTime?
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  lines         HqLine[]
  payments      HqPayment[]
  creditNotes   HqCreditNote[]
  hqRecurring   HqRecurring?   @relation(fields: [hqRecurringId], references: [id])
  hqRecurringId String?
  project       HqProject?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId     String?
  timeEntries   HqTimeEntry[]

  @@index([status, dueDate])
  @@index([issueDate])
}

/**
 * A line on a quote or an invoice.
 */
model HqLine {
  id           String        @id @default(cuid())
  quote        HqQuote?      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId      String?
  invoice      HqInvoice?    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId    String?
  creditNote   HqCreditNote? @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  creditNoteId String?
  item         HqItem?       @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemId       String?
  position     Int           @default(0)
  description  String
  quantity     Decimal       @db.Decimal(12, 3)
  unitMinor    Int
  discountPct  Decimal       @default(0) @db.Decimal(5, 2)
  taxPct       Decimal       @default(0) @db.Decimal(5, 2)
  amountMinor  Int // after discount, before tax

  @@index([quoteId])
  @@index([invoiceId])
  @@index([creditNoteId])
}

model HqPayment {
  id            String        @id @default(cuid())
  invoice       HqInvoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId     String
  date          DateTime
  amountMinor   Int // in the invoice's currency
  perGbp        Decimal       @default(1) @db.Decimal(18, 8) // rate on the day it was received
  gbpPence      Int
  method        String        @default("BANK") // BANK, CARD, CASH, PAYPAL, STRIPE, CHEQUE, OTHER, CREDIT_NOTE
  bankAccountId String? // which bank account it went into (blank = the main bank account)
  creditNote    HqCreditNote? @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  creditNoteId  String?       @unique // set when this "payment" is a credit note applied to the invoice
  reference     String?
  notes         String?
  userId        String?
  createdAt     DateTime      @default(now())

  @@index([invoiceId])
  @@index([date])
}

// ---------------- Matrix HQ: the books (phase 2) ----------------
// Matrix Infotech's own double-entry ledger, separate from any shop's. Journal amounts are GBP pence;
// lines on bank accounts also keep the amount in the bank account's own currency.

model HqAccount {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  type        AccountType
  systemKey   String?     @unique // DEBTORS, CREDITORS, SALES, FX... used by automatic postings
  isBank      Boolean     @default(false)
  currency    String      @default("GBP") // for bank accounts
  description String?
  archived    Boolean     @default(false)
  createdAt   DateTime    @default(now())

  lines    HqJournalLine[]
  bankTxns HqBankTxn[]
  items    HqItem[]
}

model HqJournal {
  id        String   @id @default(cuid())
  date      DateTime
  source    String // INVOICE, INVOICE_VOID, PAYMENT, CREDIT_NOTE, BILL, BILL_VOID, BILL_PAYMENT, BANK, MANUAL
  sourceId  String?
  reference String?
  memo      String?
  userId    String?
  createdAt DateTime @default(now())

  lines   HqJournalLine[]
  bankTxn HqBankTxn?

  @@unique([source, sourceId])
  @@index([date])
}

model HqJournalLine {
  id           String    @id @default(cuid())
  journal      HqJournal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  journalId    String
  account      HqAccount @relation(fields: [accountId], references: [id])
  accountId    String
  debitPence   Int       @default(0)
  creditPence  Int       @default(0)
  description  String?
  foreignMinor Int? // bank lines: signed amount in the bank account's currency (+ in, - out)

  @@index([accountId])
}

/**
 * One row: the books' settings.
 */
model HqSettings {
  id        String    @id @default("hq")
  lockDate  DateTime? // nothing dated on or before this can be added, changed or removed
  updatedAt DateTime  @updatedAt
}

model HqSupplier {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  vatNumber String?
  currency  String   @default("GBP")
  notes     String?
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  bills HqBill[]
}

enum HqBillStatus {
  OPEN
  PARTIAL
  PAID
  VOID
}

/**
 * A supplier bill, or an expense (a bill paid on the spot).
 */
model HqBill {
  id          String       @id @default(cuid())
  supplier    HqSupplier?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierId  String?
  payee       String // as on the bill or receipt
  reference   String? // their invoice number
  isExpense   Boolean      @default(false)
  status      HqBillStatus @default(OPEN)
  date        DateTime
  dueDate     DateTime
  currency    String       @default("GBP")
  perGbp      Decimal      @default(1) @db.Decimal(18, 8)
  netMinor    Int
  taxMinor    Int          @default(0)
  totalMinor  Int
  paidMinor   Int          @default(0)
  notes       String?
  voidedAt    DateTime?
  createdById String?
  createdAt   DateTime     @default(now())

  project   HqProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId String? // a cost for a client project (freelancer, licence)

  lines    HqBillLine[]
  payments HqBillPayment[]

  @@index([status, dueDate])
  @@index([date])
}

model HqBillLine {
  id          String  @id @default(cuid())
  bill        HqBill  @relation(fields: [billId], references: [id], onDelete: Cascade)
  billId      String
  position    Int     @default(0)
  description String
  accountId   String
  netMinor    Int
  taxPct      Decimal @default(0) @db.Decimal(5, 2)
  taxMinor    Int     @default(0)
}

model HqBillPayment {
  id            String   @id @default(cuid())
  bill          HqBill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  billId        String
  date          DateTime
  amountMinor   Int
  perGbp        Decimal  @default(1) @db.Decimal(18, 8)
  gbpPence      Int
  bankAccountId String
  reference     String?
  userId        String?
  createdAt     DateTime @default(now())

  @@index([billId])
}

enum HqCreditStatus {
  ISSUED
  VOID
}

/**
 * A credit note against an invoice. It reduces what the client owes on that invoice.
 */
model HqCreditNote {
  id            String         @id @default(cuid())
  number        String         @unique // MPC-2026-K7Q3M
  invoice       HqInvoice      @relation(fields: [invoiceId], references: [id])
  invoiceId     String
  status        HqCreditStatus @default(ISSUED)
  date          DateTime
  currency      String
  perGbp        Decimal        @default(1) @db.Decimal(18, 8)
  reason        String?
  subtotalMinor Int
  discountMinor Int            @default(0)
  taxMinor      Int            @default(0)
  totalMinor    Int
  publicToken   String         @unique
  createdById   String?
  createdAt     DateTime       @default(now())

  lines   HqLine[]
  payment HqPayment?
}

enum HqFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

/**
 * A repeating invoice: a new one is made on each date, and emailed if autoSend is on.
 */
model HqRecurring {
  id          String      @id @default(cuid())
  client      HqClient    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  title       String?
  currency    String      @default("GBP")
  lines       Json // [{ itemId, description, quantity, unit, discountPct, taxPct }] as typed
  frequency   HqFrequency @default(MONTHLY)
  nextDate    DateTime
  endDate     DateTime?
  autoSend    Boolean     @default(false)
  active      Boolean     @default(true)
  notes       String?
  terms       String?
  lastRunAt   DateTime?
  createdById String?
  createdAt   DateTime    @default(now())

  invoices HqInvoice[]

  @@index([active, nextDate])
}

enum HqBankTxnStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

/**
 * A line from a bank statement, waiting to be matched to the books.
 */
model HqBankTxn {
  id          String          @id @default(cuid())
  account     HqAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId   String
  date        DateTime
  description String
  amountMinor Int // signed: money in is positive
  importKey   String          @unique // so the same line imported twice is skipped
  status      HqBankTxnStatus @default(UNMATCHED)
  journal     HqJournal?      @relation(fields: [journalId], references: [id], onDelete: SetNull)
  journalId   String?         @unique
  createdAt   DateTime        @default(now())

  @@index([accountId, status, date])
}

// ---------------- Matrix HQ: projects, time and contracts (phase 3) ----------------

enum HqProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  DONE
  CANCELLED
}

enum HqBilling {
  FIXED // a fixed price, invoiced in stages
  HOURLY // time is invoiced at the hourly rate
  NONE // internal or not billed
}

model HqProject {
  id          String          @id @default(cuid())
  client      HqClient?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId    String? // blank = internal project
  name        String
  status      HqProjectStatus @default(ACTIVE)
  billing     HqBilling       @default(FIXED)
  currency    String          @default("GBP")
  budgetMinor Int             @default(0) // fixed price, or budget for hourly work
  rateMinor   Int             @default(0) // hourly rate, in the project's currency
  budgetHours Decimal?        @db.Decimal(10, 2)
  startDate   DateTime?
  dueDate     DateTime?
  description String?
  managerId   String? // HQ user in charge
  quoteId     String?
  createdById String?
  createdAt   DateTime        @default(now())

  tasks    HqTask[]
  time     HqTimeEntry[]
  invoices HqInvoice[]
  bills    HqBill[]
  timers   HqTimer[]

  @@index([status])
  @@index([clientId])
}

enum HqTaskStatus {
  TODO
  DOING
  REVIEW
  DONE
}

enum HqPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model HqTask {
  id              String       @id @default(cuid())
  project         HqProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  title           String
  description     String?
  status          HqTaskStatus @default(TODO)
  priority        HqPriority   @default(NORMAL)
  assigneeId      String?
  dueDate         DateTime?
  estimateMinutes Int?
  position        Int          @default(0)
  doneAt          DateTime?
  createdById     String?
  createdAt       DateTime     @default(now())

  time   HqTimeEntry[]
  timers HqTimer[]

  @@index([projectId, status])
  @@index([assigneeId, status])
}

model HqTimeEntry {
  id          String     @id @default(cuid())
  project     HqProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  task        HqTask?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId      String?
  userId      String
  date        DateTime
  minutes     Int
  description String?
  billable    Boolean    @default(true)
  invoice     HqInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId   String? // set once the time is on an invoice
  createdAt   DateTime   @default(now())

  @@index([projectId, date])
  @@index([userId, date])
  @@index([invoiceId])
}

/**
 * A running timer: one per person at a time.
 */
model HqTimer {
  id          String    @id @default(cuid())
  userId      String    @unique
  project     HqProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId   String
  task        HqTask?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId      String?
  description String?
  startedAt   DateTime  @default(now())
}

enum HqContractStatus {
  DRAFT
  ACTIVE
  ENDED
  CANCELLED
}

enum HqContractKind {
  SUPPORT
  HOSTING
  MAINTENANCE
  LICENCE // a third-party licence you resell and must renew
  DEVELOPMENT
  SERVICE
  OTHER
}

/**
 * A client agreement with an end date: support, hosting, a resold licence. Renews automatically if set.
 */
model HqContract {
  id           String           @id @default(cuid())
  client       HqClient         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId     String
  title        String
  kind         HqContractKind   @default(SERVICE)
  status       HqContractStatus @default(ACTIVE)
  reference    String? // the vendor's licence or order number
  vendor       String? // for resold licences
  startDate    DateTime
  endDate      DateTime?
  autoRenew    Boolean          @default(false)
  renewMonths  Int              @default(12)
  noticeDays   Int              @default(30) // remind this many days before it ends
  currency     String           @default("GBP")
  valueMinor   Int              @default(0) // per term
  costMinor    Int? // what it costs you per term (resold licences)
  terms        String?
  notes        String?
  recurringId  String? // the repeating invoice that bills it
  remindedFor  DateTime? // the end date the last reminder was sent for
  renewedCount Int              @default(0)
  createdById  String?
  createdAt    DateTime         @default(now())

  @@index([status, endDate])
  @@index([clientId])
}
