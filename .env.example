# MatrixPOS environment variables. Copy to .env (never committed) and fill in real values.
# This file is public: it must only ever contain placeholders.
#
# Required on the live site (the production build and the server refuse to start without them):
#   DATABASE_URL, DIRECT_URL (both with sslmode=require), AUTH_SECRET, SECRETS_ENCRYPTION_KEY, CRON_SECRET,
#   and STRIPE_WEBHOOK_SECRET whenever STRIPE_BILLING_SECRET_KEY is set. See src/lib/env.ts.
#
# Every value here is read on the server only. None of them may be renamed with a NEXT_PUBLIC_ prefix,
# because Next.js copies NEXT_PUBLIC_* values into the JavaScript sent to every browser.
# On Vercel, set them under Project > Settings > Environment Variables.
#
# Self-hosted Supabase on your UK VPS (see docs/SUPABASE.md).
# App queries go through the transaction pooler (6543); migrations use session mode (5432).
DATABASE_URL="postgresql://postgres.TENANT_ID:CHANGE_ME@your-vps-host:6543/postgres?schema=matrixpos&pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres.TENANT_ID:CHANGE_ME@your-vps-host:5432/postgres?schema=matrixpos&sslmode=require"
# Plain PostgreSQL instead (deploy/vps): set both to the same URL.
# Long random string used to sign login sessions: openssl rand -base64 48
AUTH_SECRET="CHANGE_ME"
# Your own email(s), comma separated. These accounts can open the MatrixPOS HQ dashboard at /platform.
PLATFORM_ADMIN_EMAILS=""
# Optional: shown to shop owners on the billing page. Defaults to the first platform email.
BILLING_CONTACT_EMAIL=""
# Email for sign-up confirmation and password resets. Use ONE of:
#  - Resend (resend.com): RESEND_API_KEY
#  - Any SMTP mailbox (Zoho, Hostinger, Microsoft 365, Gmail...): SMTP_HOST, SMTP_PORT (465 or 587), SMTP_USER, SMTP_PASSWORD
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
# Sender shown on emails. Must be an address your provider lets you send from.
EMAIL_FROM="MatrixPOS <no-reply@yourdomain.co.uk>"
# Optional: the site's public address for links in emails, e.g. https://pos.yourdomain.co.uk
APP_URL=""
# Shown on the privacy policy and terms (defaults to BILLING_CONTACT_EMAIL, then the first platform email).
LEGAL_CONTACT_EMAIL=""
# Protects the daily clean-up job (deletes closed accounts after 30 days). Any long random string.
CRON_SECRET=""
# Encrypts shops' Stripe Terminal, SumUp and Dojo keys in the database (AES-256-GCM). openssl rand -base64 32
# Keep it safe: if it is lost, shops must re-enter their card machine keys. To change it, move the
# current value to SECRETS_ENCRYPTION_KEY_OLD, set a new one, and redeploy.
SECRETS_ENCRYPTION_KEY=""
SECRETS_ENCRYPTION_KEY_OLD=""
# Card payments for MatrixPOS subscriptions (your own Stripe account, not the shops' terminal keys).
# Leave empty to bill by invoice only.
STRIPE_BILLING_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Optional: an existing Stripe tax rate for UK VAT. Otherwise a 20% "VAT" rate is created automatically.
STRIPE_VAT_RATE_ID=""
# Your details on invoices to shops. Separate lines with |
# Address and company number default to Matrix Infotech Ltd.'s registered office.
INVOICE_ADDRESS=""
INVOICE_COMPANY_NUMBER=""
INVOICE_VAT_NUMBER=""
# Kept out of the code because the repository is public.
INVOICE_BANK_DETAILS="Bank name|Account name: CHANGE_ME|Sort code: 00-00-00|Account number: 00000000"
INVOICE_PAYMENT_DAYS="14"
# Off by default (not VAT registered). Once registered, set to "true" and add INVOICE_VAT_NUMBER.
CHARGE_VAT="false"

# Making Tax Digital for VAT (Matrix HQ, Books → VAT). From the HMRC Developer Hub; redirect URI is <APP_URL>/api/hmrc/callback.
# HMRC_ENV is "sandbox" (HMRC's test service) until HMRC approves the app for "production".
HMRC_CLIENT_ID=""
HMRC_CLIENT_SECRET=""
HMRC_ENV="sandbox"
# Development / preview only: print emails (including sign-in and reset links) to the log instead of sending.
# Ignored on the live site.
# EMAIL_LOG="1"
# Shows the demo business's sign-in details on the login page. Always shown in development and previews;
# on the live site only when set to "true" (its password is public, so only if the demo business is meant to be there).
# SHOW_DEMO_LOGIN=""
# Only for a deliberate demo database: lets `npm run db:seed` run when NODE_ENV is production.
# ALLOW_DEMO_SEED=""
