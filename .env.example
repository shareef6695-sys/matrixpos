# Self-hosted Supabase on your UK VPS (see docs/SUPABASE.md).
# App queries go through the transaction pooler (6543); migrations use session mode (5432).
DATABASE_URL="postgresql://postgres.TENANT_ID:CHANGE_ME@your-vps-host:6543/postgres?schema=matrixpos&pgbouncer=true&connection_limit=1&sslmode=require"
DIRECT_URL="postgresql://postgres.TENANT_ID:CHANGE_ME@your-vps-host:5432/postgres?schema=matrixpos&sslmode=require"
# Plain PostgreSQL instead (deploy/vps): set both to the same URL.
# Long random string used to sign login sessions: openssl rand -base64 48
AUTH_SECRET="CHANGE_ME"
# Your own email(s), comma separated. These accounts can open the MatrixPOS HQ dashboard at /platform.
PLATFORM_ADMIN_EMAILS=""
# Optional: shown to shop owners on the billing page. Defaults to the first platform email.
BILLING_CONTACT_EMAIL=""
# Email for sign-up confirmation and password resets. Use ONE of:
#  - Resend (resend.com): RESEND_API_KEY
#  - Any SMTP mailbox (Zoho, Hostinger, Microsoft 365, Gmail...): SMTP_HOST, SMTP_PORT (465 or 587), SMTP_USER, SMTP_PASSWORD
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
# Sender shown on emails. Must be an address your provider lets you send from.
EMAIL_FROM="MatrixPOS <no-reply@yourdomain.co.uk>"
# Optional: the site's public address for links in emails, e.g. https://pos.yourdomain.co.uk
APP_URL=""
# Shown on the privacy policy and terms (defaults to BILLING_CONTACT_EMAIL, then the first platform email).
LEGAL_CONTACT_EMAIL=""
# Protects the daily clean-up job (deletes closed accounts after 30 days). Any long random string.
CRON_SECRET=""
# Card payments for MatrixPOS subscriptions (your own Stripe account, not the shops' terminal keys).
# Leave empty to bill by invoice only.
STRIPE_BILLING_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Optional: an existing Stripe tax rate for UK VAT. Otherwise a 20% "VAT" rate is created automatically.
STRIPE_VAT_RATE_ID=""
# Your details on invoices to shops. Separate lines with |
INVOICE_ADDRESS="1 High Street|London|E1 1AA"
INVOICE_COMPANY_NUMBER=""
INVOICE_VAT_NUMBER=""
INVOICE_BANK_DETAILS="Account name: Matrix Infotech Ltd|Sort code: 00-00-00|Account number: 12345678"
INVOICE_PAYMENT_DAYS="14"
# Set to "false" if you are not VAT registered: no VAT is added to invoices or card payments.
CHARGE_VAT="true"
